<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SimpleTweaks</AssemblyName>
    <RootNamespace>SimpleTweaks</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <PluginVersion>0.5.8</PluginVersion>
    <AssemblyVersion>$(PluginVersion)</AssemblyVersion>
    <FileVersion>$(PluginVersion)</FileVersion>
    <InformationalVersion>$(PluginVersion)</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup><GameDir Condition="'$(GameDir)' == ''">$(SOLAR_EXPANSE_DIR)</GameDir></PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\Solar Expanse_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\Solar Expanse_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\Solar Expanse_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameDir)\Solar Expanse_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(GameDir)\Solar Expanse_Data\Managed\Sirenix.Serialization.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)\Solar Expanse_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\Solar Expanse_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)\Solar Expanse_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Generate VersionConstants.cs from the single $(PluginVersion) property.
       %3B escapes semicolons because MSBuild uses ; as an item separator. -->
  <Target Name="GenerateVersionFile" BeforeTargets="BeforeBuild">
    <WriteLinesToFile
        File="$(IntermediateOutputPath)VersionConstants.cs"
        Lines="internal static class VersionConstants { internal const string PluginVersion = &quot;$(PluginVersion)&quot;%3B }"
        Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)VersionConstants.cs" />
    </ItemGroup>
  </Target>

  <Target Name="PackRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_StageRoot>$(IntermediateOutputPath)zipstage\</_StageRoot>
    </PropertyGroup>
    <RemoveDir Directories="$(_StageRoot)" />
    <MakeDir Directories="$(_StageRoot)SimpleTweaks\" />
    <Copy SourceFiles="$(OutputPath)SimpleTweaks.dll" DestinationFolder="$(_StageRoot)SimpleTweaks\" />
    <ZipDirectory SourceDirectory="$(_StageRoot)" DestinationFile="$(OutputPath)SimpleTweaks_v$(PluginVersion).zip" Overwrite="true" />
    <RemoveDir Directories="$(_StageRoot)" />

    <MakeDir Directories="$(GameDir)\BepInEx\plugins\SimpleTweaks\" />
    <Copy SourceFiles="$(OutputPath)SimpleTweaks.dll" DestinationFolder="$(GameDir)\BepInEx\plugins\SimpleTweaks\" Retries="0" ContinueOnError="true" />
  </Target>

</Project>
